#!/bin/sh
# The seam between this project and everything that automates it.
#
# CI, the git hooks and scripts/agent know only the verbs below. Nothing outside
# this file knows liam is written in Rust, which is what keeps the automation
# from having to be rewritten when any of that changes — and what makes it
# impossible for CI and a local hook to drift apart, since they run the same
# line.
set -eu

cd "$(dirname "$0")/.."

step() {
  printf '\n\033[1;34m▸ %s\033[0m\n' "$1"
}

# The site is a separate toolchain behind the same verbs. Installing from the
# lockfile every time is cheap when nothing changed and keeps a stale
# node_modules from passing a check CI would fail.
site() {
  pnpm --dir site install --frozen-lockfile --silent
  pnpm --dir site "$@"
}

usage() {
  cat <<'USAGE'
usage: scripts/task <target>

  fmt        format in place
  fmt:check  verify formatting; non-zero on drift
  lint       lint; warnings are errors
  test       the full test suite
  build      compile everything, including the tests
  build:static  release musl binaries for the image; fails unless static (Linux)
  check      fmt:check, lint, test, build — what CI runs

USAGE
}

case "${1:-}" in
  # The site has no formatter configured; Rust formatting is the whole target.
  fmt)
    cargo fmt --all
    ;;
  fmt:check)
    cargo fmt --all -- --check
    ;;
  lint)
    cargo clippy --all-targets --all-features -- -D warnings
    site run --silent check
    ;;
  # The site has no tests yet; astro check in lint and the build cover it.
  test)
    cargo test --all-targets
    ;;
  build)
    cargo build --all-targets
    site run --silent build
    ;;
  build:static)
    # What goes into an image: release builds for musl, which must be static
    # because the image has no dynamic linker. Linux only; CI runs it there.
    target=x86_64-unknown-linux-musl
    if [ "$(uname -s)" != Linux ]; then
      printf 'scripts/task build:static: needs Linux with musl-gcc; CI runs it\n' >&2
      exit 1
    fi
    cargo build --release --locked --target "$target" -p liamd -p liam-init
    # scripts/lab points CARGO_TARGET_DIR outside the checkout.
    for bin in liamd liam-init; do
      path="${CARGO_TARGET_DIR:-target}/$target/release/$bin"
      kind=$(file -b "$path")
      case "$kind" in
        *'statically linked'* | *'static-pie linked'*) ;;
        *)
          printf '%s is not static: %s\n' "$bin" "$kind" >&2
          exit 1
          ;;
      esac
      printf '%-10s %8s bytes  %s\n' "$bin" "$(wc -c <"$path" | tr -d ' ')" "$kind"
    done
    ;;
  check)
    step 'format'
    "$0" fmt:check
    step 'lint'
    "$0" lint
    step 'test'
    "$0" test
    step 'build'
    "$0" build
    printf '\n\033[1;32m✓ green\033[0m\n'
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    printf 'scripts/task: unknown target %s\n\n' "${1:-<none>}" >&2
    usage >&2
    exit 2
    ;;
esac
