---
import Container from '../layout/Container.astro';
import Cluster from '../layout/Cluster.astro';
import Wordmark from '../ui/Wordmark.astro';
import Button from '../ui/Button.astro';
import Terminal from '../ui/Terminal.astro';
import { bootTrace } from '../../data/boot';
---

<section class="hero" aria-labelledby="hero-title">
  <Container>
    <h1 id="hero-title"><Wordmark size="hero"><span class="stamp">[0.019 s]</span></Wordmark></h1>
    <div class="grid">
      <div>
        <p class="thesis">The web server is the operating system.</p>
        <p class="lede">
          liam is a free, open-source OS image for serving websites. One Rust binary runs as PID&nbsp;1 on a stripped Linux
          kernel. It boots in milliseconds, serves from memory, and ships as a container, a microVM, or a bare-metal disk
          from a single config file.
        </p>
        <div class="ctas">
          <Cluster gap="3">
            <Button variant="primary" href="#budgets">See the budgets</Button>
            <Button href="#config">Read liam.toml</Button>
          </Cluster>
        </div>
        <p class="fine">Unikernel speed, Linux drivers, no shell. MIT or Apache-2.0.</p>
      </div>
      <Terminal
        title="firecracker · 2 vCPU · 256 MiB"
        lines={bootTrace}
        caption="Design target, not a measurement. Replayed at 1/100 speed."
      />
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-block: clamp(32px, 6vw, 72px) clamp(40px, 6vw, 80px);
  }

  .stamp {
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    font-stretch: var(--stretch-normal);
    font-size: var(--size-stamp);
    letter-spacing: 0.02em;
    color: var(--color-accent);
    vertical-align: top;
    margin-left: 0.6em;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 64px);
    margin-top: clamp(28px, 4vw, 48px);
    align-items: start;
  }

  .thesis {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-stretch: var(--stretch-wide);
    font-size: var(--size-2xl);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .lede {
    margin-top: 18px;
    font-size: var(--size-lg);
    color: var(--color-text-muted);
    max-width: 34em;
  }

  .ctas {
    margin-top: 28px;
  }

  .fine {
    margin-top: var(--space-4);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
