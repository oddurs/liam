---
import Container from '../layout/Container.astro';
import Cluster from '../layout/Cluster.astro';
import Wordmark from '../ui/Wordmark.astro';
import Pill from '../ui/Pill.astro';

const links = [
  ['#budgets', 'Budgets'],
  ['#anatomy', 'Anatomy'],
  ['#hotpath', 'Hot path'],
  ['#config', 'Config'],
  ['#deploy', 'Deploy'],
  ['#roadmap', 'Roadmap'],
];
---

<header class="header">
  <Container>
    <Cluster gap="5" justify="between">
      <Cluster gap="5">
        <Wordmark href="/" />
        <nav aria-label="Sections">
          <Cluster as="ul" gap="5">
            {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
          </Cluster>
        </nav>
      </Cluster>
      <Pill tone="mark">Pre-alpha · built in the open</Pill>
    </Cluster>
  </Container>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
    padding-block: 14px;
  }

  ul {
    list-style: none;
    padding: 0;
    font-size: var(--size-sm);
  }

  nav a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    nav {
      display: none;
    }
  }
</style>
