---
/* A heading and its explanation: used in Config, Deploy and Stability. */
interface Props {
  title: string;
  ruled?: boolean;
}

const { title, ruled = false } = Astro.props;
---

<div class:list={['point', { ruled }]}>
  <h3>{title}</h3>
  <p><slot /></p>
</div>

<style>
  .ruled {
    border-top: 2px solid var(--color-text);
    padding-top: var(--space-4);
  }

  h3 {
    font-size: var(--size-lg);
    font-weight: 650;
    line-height: var(--leading-snug);
  }

  p {
    color: var(--color-text-muted);
    margin-top: 6px;
    font-size: 15px;
  }

  p :global(code) {
    font-size: 13px;
    color: var(--color-text);
  }
</style>
