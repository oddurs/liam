---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
}

const { as: Tag = 'div', ...rest } = Astro.props;
---

<Tag class="container" {...rest}><slot /></Tag>

<style>
  .container {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
